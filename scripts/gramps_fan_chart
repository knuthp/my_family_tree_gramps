#!/bin/bash

# Dir of script
DIR=`dirname "$0"`
TARGET_DIR=${DIR}/../_build

echo $PWD
NAME=fan_chart
OUTPUT_DIR="_build"
mkdir -p "$OUTPUT_DIR"

KNUT_PEDERSEN="I0020"
EMMA_PEDERSEN="I0001"
ASBJORN_PEDERSEN="I0000"
ASTRID_LANGEBREKKE="I0022"
KRISTIAN_LANGEBREKKE="I0021"
AUD_JENSEN="I0736"
BJARNE_JENSEN="I0735"
GERD_DAHL="I0384"
GUNNAR_DAHL="I0355"


declare -a ANCESTORS=($ASTRID_LANGEBREKKE $KRISTIAN_LANGEBREKKE $EMMA_PEDERSEN $ASBJORN_PEDERSEN $AUD_JENSEN $BJARNE_JENSEN $GERD_DAHL $GUNNAR_DAHL)

for PID in "${ANCESTORS[@]}"; do
    FILENAME="${OUTPUT_DIR}/$(echo $PID | tr ' ' '_')_fan_chart.svg"
    gramps -O knuthp -a report -p "name=$NAME,pid=$PID,of=$FILENAME"
done